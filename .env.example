NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/msr_dev
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/msr_test
UPLOAD_DIR=./storage
MAX_UPLOAD_MB=25
# Cloudflare R2 bucket for attachments and avatars. Set all four, or leave them empty to keep files in UPLOAD_DIR.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
RESEND_API_KEY=
SMTP_URL=
MAIL_FROM="MSR Tracker <no-reply@msr.local>"
# 32 random bytes, base64 (openssl rand -base64 32). Required in production; never change it once set.
ENCRYPTION_KEY=
# Google Calendar sync (OAuth web client). Leave empty to hide "Connect Google Calendar".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Telegram bot token from @BotFather. Leave empty to hide the Telegram settings.
TELEGRAM_BOT_TOKEN=
ENABLE_DEMO_DATA=true
# Development only: ignored when NODE_ENV=production
DISABLE_RATE_LIMIT=false
