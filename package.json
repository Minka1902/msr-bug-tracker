{
  "name": "msr-bug-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./server --filter ./client run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter ./server run start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck && tsc -p e2e",
    "test": "pnpm -r run test",
    "e2e": "playwright test",
    "db:migrate": "pnpm --filter ./server run db:migrate",
    "db:seed": "pnpm --filter ./server run db:seed"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7"
  }
}
