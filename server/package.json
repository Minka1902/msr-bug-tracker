{
  "name": "@msr/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrateCli.ts",
    "db:seed": "tsx src/modules/demo/seedCli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@msr/shared": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "aws4fetch": "1.0.20",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "file-type": "22.2.0",
    "fractional-indexing": "4.0.0",
    "helmet": "8.3.0",
    "ical.js": "2.2.1",
    "multer": "2.5.0",
    "nodemailer": "10.2.1",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "tsdav": "2.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "7.3.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vitest": "3.2.7"
  }
}
